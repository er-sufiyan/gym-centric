PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gymcentric?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=30d
FRONTEND_URL=https://your-frontend.vercel.app

# Free Email OTP via Gmail SMTP / Nodemailer (Use a Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM=your_gmail@gmail.com

# Meta WhatsApp Cloud API (Optional - required for live WhatsApp OTP delivery)
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
